{
  "name": "evernet-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api": "npm --prefix storage-api run dev",
    "api:start": "npm --prefix storage-api run start",
    "sdk:build": "npm --prefix sdk run build",
    "sdk:example": "npm --prefix sdk run example:encrypt-upload",
    "contract:build": "cd contracts/storage-market && cargo build --target wasm32v1-none --release"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@evernet/sdk": "file:sdk",
    "@stellar/stellar-sdk": "^16.2.0",
    "buffer": "^6.0.3",
    "framer-motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
