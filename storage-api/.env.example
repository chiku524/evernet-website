PORT=8787
STELLAR_NETWORK=testnet
STELLAR_RECEIVER=GCUBXGWBBJ4I276JPFQMBJIB5ZR4RJOV47C3YRWZHWITVQXJQKCW72D7
STELLAR_ADMIN_SECRET=
STORAGE_CONTRACT_ID=

# Signs session tokens, derives the SEP-10 challenge keypair, and salts blob
# pathnames. Changing it invalidates sessions AND orphans stored objects.
API_JWT_SECRET=change-me

# Vercel Blob token. When set, objects persist there instead of local disk —
# required on serverless, where /tmp is wiped between requests.
BLOB_READ_WRITE_TOKEN=

# Extra allowed origins. evernet.tech, *.vercel.app and localhost are always
# permitted, so this is only needed for custom domains.
CORS_ORIGIN=
